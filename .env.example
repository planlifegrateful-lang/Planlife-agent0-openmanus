# Environment variables for Planlife OpenManus pipeline
# Copy to .env and fill real values before running:
#   cp .env.example .env

# Service ports
VIDEO_BUILDER_PORT=8001
WEBHOOK_LISTENER_PORT=8000
OPENMANUS_PORT=8002
N8N_PORT=5678

# n8n basic auth (CHANGE THESE)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Integration keys (DO NOT commit real secrets)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
SOCIAL_MEDIA_API_KEY=your-social-api-key

# Output (used inside container; host path is managed by named volume)
OUTPUT_DIR=/data/output
