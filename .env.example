# Local-only defaults. Keep loopback bindings unless the exposed service is protected.
VIDEO_BUILDER_BIND_ADDRESS=127.0.0.1
WEBHOOK_LISTENER_BIND_ADDRESS=127.0.0.1
OPENMANUS_BIND_ADDRESS=127.0.0.1
N8N_BIND_ADDRESS=127.0.0.1

VIDEO_BUILDER_PORT=8001
WEBHOOK_LISTENER_PORT=8000
OPENMANUS_PORT=8002
N8N_PORT=5678

# n8n uses its built-in owner/user-management login; legacy N8N_BASIC_AUTH_* variables were removed in n8n v1.
# Create the owner account in the browser on first startup.
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

OUTPUT_DIR=/data/output
