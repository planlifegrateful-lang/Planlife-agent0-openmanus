# Environment variables example for Planlife OpenManus pipeline
# Copy to .env and fill in real values before running

# Service ports
VIDEO_BUILDER_PORT=8001
WEBHOOK_LISTENER_PORT=8000
OPENMANUS_PORT=8002
N8N_PORT=5678

# Example integration keys (DO NOT store real secrets here)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
SOCIAL_MEDIA_API_KEY=your-social-api-key

# Output
OUTPUT_DIR=./data/video-output
